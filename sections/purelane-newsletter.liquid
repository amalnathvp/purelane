{% comment %}
  Purelane Club Newsletter Signup Section
  Incentivized email capture connected to Shopify customer registration.
{% endcomment %}

<section class="sec" data-scene="4" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="glass signup rv">
      {% if section.settings.kicker != blank %}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.title }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="pl-lede" style="margin:0 auto">{{ section.settings.subheading }}</p>
      {% endif %}

      {% form 'customer', class: 'purelane-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter,purelane-club">
        {% if form.posted_successfully? %}
          <p class="pl-body-s" style="color:#4f7d10;font-weight:700;margin-top:16px;">
            {{ section.settings.success_message | default: "Thank you for joining! Your ₹100 code is PURE100" }}
          </p>
        {% else %}
          {% if form.errors %}
            <p class="pl-body-s" style="color:#c9761d;margin-top:10px;">{{ form.errors.messages['email'] }}</p>
          {% endif %}
          <div style="display:flex;gap:9px;max-width:430px;margin:22px auto 0;flex-wrap:wrap;width:100%;">
            <input
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.placeholder | default: 'your@email.com' }}"
              aria-label="Email address"
              required
              autocorrect="off"
              autocapitalize="off"
            >
            <button class="btn btn-primary" type="submit">
              {{ section.settings.button_label | default: 'Get my ₹100 off' }}
            </button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Newsletter",
  "tag": "section",
  "class": "section-purelane-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Get my ₹100 off"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thank you for joining! Your ₹100 code is PURE100"
    }
  ],
  "presets": [
    {
      "name": "Purelane Newsletter"
    }
  ]
}
{% endschema %}
