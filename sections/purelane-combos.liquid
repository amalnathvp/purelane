{% comment %}
  Purelane Best Selling Combos Section
  Horizontal scroll rail showcasing multi-product bundles with stack visualizations and savings badges.
{% endcomment %}

<section class="sec" id="combos" data-scene="3" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="panel-head rv">
      {% if section.settings.kicker != blank %}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.title }}</h2>
      <div class="rule">
        <i></i>
        {% render 'purelane-svg-icons', name: 'leaf' %}
        <i></i>
      </div>
      {% if section.settings.subheading != blank %}
        <p class="pl-lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="comborail rv">
      {% for block in section.blocks %}
        {% if block.type == 'combo_card' %}
          {% liquid
            assign is_hero = block.settings.is_featured
            assign p1 = block.settings.product_1
            assign p2 = block.settings.product_2
            assign p3 = block.settings.product_3
            assign bundle_product = block.settings.bundle_product
          %}

          <article class="glass combo{% if is_hero %} hero-combo{% endif %}" {{ block.shopify_attributes }}>
            <div class="tray">
              {% if block.settings.savings_pill != blank %}
                <span class="save">{{ block.settings.savings_pill }}</span>
              {% endif %}
              {% if block.settings.flag_pill != blank %}
                <span class="flag">{{ block.settings.flag_pill }}</span>
              {% endif %}

              <div class="stack">
                {%- comment -%} Item 1 {%- endcomment -%}
                <span class="it">
                  {% if block.settings.image_1 != blank %}
                    <img src="{{ block.settings.image_1 | image_url: width: 140 }}" alt="{{ block.settings.image_1.alt | escape }}" loading="lazy" width="70" height="66">
                  {% elsif p1 != blank and p1.featured_image != blank %}
                    <img src="{{ p1.featured_image | image_url: width: 140 }}" alt="{{ p1.title | escape }}" loading="lazy" width="70" height="66">
                  {% else %}
                    <span class="pimg {{ block.settings.silhouette_1 | default: 'p-kitchen' }}" role="img" aria-label="Product 1"></span>
                  {% endif %}
                  <span>{{ block.settings.caption_1 }}</span>
                </span>

                {%- comment -%} Plus separator {%- endcomment -%}
                <span class="plus" aria-hidden="true">+</span>

                {%- comment -%} Item 2 {%- endcomment -%}
                <span class="it">
                  {% if block.settings.is_tile_2 %}
                    <span class="tile">{% render 'purelane-svg-icons', name: 'leaf' %}</span>
                  {% elsif block.settings.image_2 != blank %}
                    <img src="{{ block.settings.image_2 | image_url: width: 140 }}" alt="{{ block.settings.image_2.alt | escape }}" loading="lazy" width="70" height="66">
                  {% elsif p2 != blank and p2.featured_image != blank %}
                    <img src="{{ p2.featured_image | image_url: width: 140 }}" alt="{{ p2.title | escape }}" loading="lazy" width="70" height="66">
                  {% else %}
                    <span class="pimg {{ block.settings.silhouette_2 | default: 'p-dish' }}" role="img" aria-label="Product 2"></span>
                  {% endif %}
                  <span>{{ block.settings.caption_2 }}</span>
                </span>

                {%- comment -%} Item 3 (Optional) {%- endcomment -%}
                {% if block.settings.show_item_3 %}
                  <span class="plus" aria-hidden="true">+</span>
                  <span class="it">
                    {% if block.settings.image_3 != blank %}
                      <img src="{{ block.settings.image_3 | image_url: width: 140 }}" alt="{{ block.settings.image_3.alt | escape }}" loading="lazy" width="70" height="66">
                    {% elsif p3 != blank and p3.featured_image != blank %}
                      <img src="{{ p3.featured_image | image_url: width: 140 }}" alt="{{ p3.title | escape }}" loading="lazy" width="70" height="66">
                    {% else %}
                      <span class="pimg {{ block.settings.silhouette_3 | default: 'p-tap' }}" role="img" aria-label="Product 3"></span>
                    {% endif %}
                    <span>{{ block.settings.caption_3 }}</span>
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="body">
              <h3>{{ block.settings.title }}</h3>
              <div class="cnt">{{ block.settings.item_count_label }}</div>
              <p class="inc">{{ block.settings.description }}</p>

              <div class="prow">
                <strong>{{ block.settings.price }}</strong>
                {% if block.settings.compare_price != blank %}
                  <s>{{ block.settings.compare_price }}</s>
                {% endif %}
                {% if block.settings.save_tag != blank %}
                  <em>{{ block.settings.save_tag }}</em>
                {% endif %}
              </div>

              <div class="fine">{{ block.settings.fine_print | default: 'Inclusive of all taxes · COD available' }}</div>

              {% if bundle_product != blank and bundle_product.available %}
                <form action="/cart/add" method="post" enctype="multipart/form-data">
                  <input type="hidden" name="id" value="{{ bundle_product.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="btn {% if is_hero %}btn-primary{% else %}btn-ghost{% endif %}">
                    {{ block.settings.cta_label | default: 'Shop bundle' }}
                    {% render 'purelane-svg-icons', name: 'arrow-right' %}
                  </button>
                </form>
              {% else %}
                <a class="btn {% if is_hero %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.cta_url | default: '#bundles' }}">
                  {{ block.settings.cta_label | default: 'Shop bundle' }}
                  {% render 'purelane-svg-icons', name: 'arrow-right' %}
                </a>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.swipecue != blank %}
      <div class="swipecue" aria-hidden="true">
        {% render 'purelane-svg-icons', name: 'arrow-right' %}
        {{ section.settings.swipecue }}
      </div>
    {% endif %}

    {% if section.settings.railnote != blank %}
      <p class="railnote">{{ section.settings.railnote }}</p>
    {% endif %}
  </div>
</section>

