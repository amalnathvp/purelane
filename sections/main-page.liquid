<div class="sec" style="padding:60px 20px;">
  <div class="pl-wrap">
    <div class="glass sec-pad" style="max-width:800px;margin:0 auto;">
      <h1 class="pl-d2">{{ page.title }}</h1>
      <div class="rte" style="margin-top:20px;line-height:1.7;">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "tag": "section",
  "class": "section-main-page"
}
{% endschema %}
