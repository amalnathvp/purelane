{% comment %}
  Purelane SVG Icon Helper Snippet
  Usage: {% render 'purelane-svg-icons', name: 'leaf' %}
{% endcomment %}

{% case name %}
  {% when 'leaf' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
      <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
    </svg>
  {% when 'shield' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
      <path d="m9 12 2.2 2.2L15.4 10"/>
    </svg>
  {% when 'ban' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="8.4"/>
      <path d="M6.4 17.6 17.6 6.4"/>
    </svg>
  {% when 'arrow-right' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h13m-5-6 6 6-6 6"/>
    </svg>
  {% when 'check' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m5 13 4 4L19 7"/>
    </svg>
  {% when 'cart' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/>
      <circle cx="10" cy="20.5" r="1.1"/>
      <circle cx="17.5" cy="20.5" r="1.1"/>
    </svg>
  {% when 'search' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/>
      <path d="m20 20-3.5-3.5"/>
    </svg>
  {% when 'account' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="8" r="3.6"/>
      <path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/>
    </svg>
  {% when 'menu' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path d="M4 8h16M4 16h16"/>
    </svg>
  {% when 'logo' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
      <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
    </svg>
  {% when 'box-open' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/>
      <path d="M4 8 6.5 3h11L20 8M9.5 12h5"/>
    </svg>
  {% when 'heart-hand' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/>
    </svg>
  {% when 'globe-india' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="8.6"/>
      <path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/>
    </svg>
  {% when 'bubbles' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="8" cy="8.5" r="3.2"/>
      <circle cx="16.4" cy="6.6" r="2.2"/>
      <circle cx="15" cy="13" r="2.8"/>
      <circle cx="8.6" cy="15.6" r="2.1"/>
      <path d="M4 21h16"/>
    </svg>
  {% when 'discount' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3v18"/>
      <path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/>
    </svg>
  {% when 'truck' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2.6 16.4V7.2h10.2v9.2"/>
      <path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/>
      <circle cx="6.6" cy="18" r="1.9"/>
      <circle cx="16.6" cy="18" r="1.9"/>
    </svg>
  {% when 'star-badge' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/>
    </svg>
  {% when 'checkbox' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="4" y="4" width="16" height="16" rx="3.4"/>
      <path d="m8.4 12.2 2.4 2.4 4.8-5"/>
    </svg>
  {% when 'fallback-bottle' %}
    <svg viewBox="0 0 130 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="card-svg-fallback">
      <defs>
        <linearGradient id="gPlFb" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#ffffff" stop-opacity=".10"/>
          <stop offset=".18" stop-color="#ffffff" stop-opacity=".38"/>
          <stop offset=".5" stop-color="#dff3e4" stop-opacity=".10"/>
          <stop offset=".82" stop-color="#ffffff" stop-opacity=".22"/>
          <stop offset="1" stop-color="#9fc7b4" stop-opacity=".32"/>
        </linearGradient>
        <linearGradient id="gPlFl" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#04756e"/>
          <stop offset=".55" stop-color="#4b3a8f"/>
          <stop offset="1" stop-color="#013f3d"/>
        </linearGradient>
        <linearGradient id="gPlFc" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#8fa89b"/>
          <stop offset=".22" stop-color="#eef6ef"/>
          <stop offset="1" stop-color="#7d938c"/>
        </linearGradient>
      </defs>
      <ellipse cx="65" cy="190" rx="40" ry="7" fill="#01201c" opacity=".18"/>
      <path d="M40 60V48c0-7 5-12 12-12h13c8 0 13 6 13 13v11Z" fill="url(#gPlFc)"/>
      <path d="M65 37c11-1 19 3 25 10 3 4 2 9-2 10l-20 3Z" fill="#cfdcd2"/>
      <path d="M14 44h27v9H19c-4 0-6-2-6-4s1-5 1-5Z" fill="#cfdcd2"/>
      <path d="M44 52c-7 3-11 9-10 16 1 6 5 10 12 10v-6c-4 0-6-2-6-5s2-6 5-7Z" fill="#cfdcd2"/>
      <rect x="38" y="56" width="42" height="7" rx="3" fill="#a8bdb2"/>
      <rect x="41" y="62" width="36" height="16" rx="4" fill="url(#gPlFc)"/>
      <path d="M28 96c0-11 6-18 15-24v-8h33v8c9 6 15 13 15 24v62c0 12-8 20-21 20H49c-13 0-21-8-21-20Z" fill="url(#gPlFb)" stroke="rgba(75,58,143,.18)" stroke-width="1.4"/>
      <rect x="31" y="112" width="66" height="60" rx="6" fill="url(#gPlFl)"/>
      <rect x="31" y="112" width="66" height="60" rx="6" fill="none" stroke="rgba(236,230,247,.26)" stroke-width="1"/>
      <g transform="translate(58 120) scale(.5)" fill="none" stroke="#b8701c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
        <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
      </g>
      <text x="64" y="140" text-anchor="middle" font-family="Outfit, sans-serif" font-size="8.6" font-weight="800" letter-spacing=".7" fill="#faf7fd">PURELANE</text>
      <line x1="42" y1="146" x2="86" y2="146" stroke="#b8701c" stroke-width=".9" opacity=".85"/>
      <text x="64" y="156" text-anchor="middle" font-family="Inter, sans-serif" font-size="6.4" font-weight="700" letter-spacing="1.1" fill="#ece6f7">NATURAL</text>
      <text x="64" y="164" text-anchor="middle" font-family="Inter, sans-serif" font-size="6.4" font-weight="700" letter-spacing="1.1" fill="#ece6f7">CARE</text>
      <text x="64" y="171" text-anchor="middle" font-family="Inter, sans-serif" font-size="4.8" font-weight="600" letter-spacing=".9" fill="rgba(236,230,247,.7)">500 ML</text>
      <rect x="36" y="98" width="6" height="72" rx="3" fill="#ffffff" opacity=".3"/>
      <rect x="86" y="102" width="4" height="64" rx="2" fill="#ffffff" opacity=".18"/>
    </svg>
{% endcase %}
